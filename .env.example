# Copy to .env.local (gitignored) and fill in. Restart the dev server after edits.
#
# WARNING: EXPO_PUBLIC_* values are inlined into the JS bundle, so anyone with
# the app can read them. Fine for a hackathon with throwaway keys; a shipped app
# must proxy both calls through a server and keep these out of the client.

# Required — YouTube transcripts. https://serpapi.com/manage-api-key
EXPO_PUBLIC_SERPAPI_KEY=

# Itinerary generation. Set one of the two; Gemini wins if both are present.
# Without either, the app falls back to a transcript outline instead of a plan.
# https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=
# https://console.anthropic.com/settings/keys
EXPO_PUBLIC_ANTHROPIC_API_KEY=
